<Page x:Class="WpfApp1.P.Add_InterestGroup_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.P"
      mc:Ignorable="d" 
      xmlns:validators="clr-namespace:WpfApp1.Valid"
      d:DesignHeight="750" d:DesignWidth="800"
      Title="Add_InterestGroup_Page">

    <Grid Background="White">

        <StackPanel>
          
            <StackPanel>
                <Label>Login</Label>
                <TextBox x:Name="TitleTB">


                    <TextBox.Text>
                        <Binding Path="Title" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:Login/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <ItemsControl Foreground="Red"
                          FontSize="12"
                          ItemsSource="{Binding ElementName=TitleTB, Path=(Validation.Errors)}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent}" TextWrapping="wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </StackPanel>
            
            <StackPanel>
                <Label>Description</Label>
                <TextBox x:Name="DescTB">
                    <TextBox.Text>
                        <Binding Path="Description" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:ContainDog/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <ItemsControl Foreground="Red"
          FontSize="12"
          ItemsSource="{Binding ElementName=DescTB, Path=(Validation.Errors)}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent}" TextWrapping="wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </StackPanel>

            <StackPanel>

                <Button Click="save" Content="Сохранить в БД">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignFlatLightBgButton}" TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Click="back">Назад</Button>
            </StackPanel>
            
        </StackPanel>


        
        
        
    </Grid>
</Page>
