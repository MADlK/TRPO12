<Page x:Class="WpfApp1.P.AddIGForUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.P"
      xmlns:all="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="800"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AddIGForUser"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">


    <Page.Resources>
        <all:TrueOrFalse x:Key="TRY"/>
    </Page.Resources>
    
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="3*"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel  Grid.Row="1" Grid.Column="0">
            <TextBlock Text="{Binding student.Name}"/>
            <TextBlock Text="{Binding student.Login}"/>
            <TextBlock Text="{Binding student.Email}"/>
            <TextBlock Text="{Binding student.CreatedAt, StringFormat={}{0:dd.MM.yyyy}}"/>
            <TextBlock Text="{Binding student.Profile.Phone}"/>
            <TextBlock Text="{Binding student.Profile.AvatarUrl}"/>
            <TextBlock Text="{Binding student.Profile.Birthday, StringFormat={}{0:dd.MM.yyyy}}"/>
            <TextBlock Text="{Binding student.Profile.Bio}"/>
            <TextBlock Text="{Binding student.Role.Title}"/>
        </StackPanel>


        <TextBlock  Text="Информация о студенте" FontSize="25"/>

        <Border Grid.Row="1"
                BorderBrush="Green"
                Grid.Column="1"
                BorderThickness="3">
            <ListView 
           
       
     
     Name="LV"
     ItemsSource="{Binding UIGService.UserInterestGroups}" Cursor=""
    
     >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding InterestGroup.Title}"/>
                                <TextBlock Text="{Binding InterestGroup.Description}"/>
                                <TextBlock Text="{Binding JoinedAt}"/>
                                <TextBlock Text="{Binding IsModerator, Converter={StaticResource TRY}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>


        </Border>
        
       


        <StackPanel HorizontalAlignment="Center"
                    Grid.Row="2" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Модратор?" Margin="0 0 5 0"/>
                <CheckBox IsChecked="{Binding UIG.IsModerator}"/>
            </StackPanel>
            

            <ComboBox Height="50"
                      Name="IGBox"
                      SelectedItem="{Binding IGselected}"
                      ItemsSource="{Binding IGServise.InterstGroups}"
                      DisplayMemberPath="Title"
                      BorderThickness="1"
                      Width="150"
                      materialDesign:HintAssist.Hint="Выберите в какую группу добавить">

            </ComboBox>
            <Button Name="AddBtn"  Click="AddBtn_Click" Content="Добавить "/>
        </StackPanel>

        <Button Content="Назад" Click="goBack" Grid.Row="2"/>

    </Grid>
</Page>
