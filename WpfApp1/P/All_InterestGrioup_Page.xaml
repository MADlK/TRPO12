<Page x:Class="WpfApp1.P.All_InterestGrioup_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.P"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="All_InterestGrioup_Page">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Click="Add_Click" Content="Добавить" Margin="20 0 0 0"/>
            <Button Click="Edit_Click" Content="Редактировать" Margin="20 0 0 0"/>
            <Button Click="Del_Click" Content="Удалить" Margin="20 0 0 0"/>
        </StackPanel>


        <ListView Grid.Row="1"
           Width="500"
             ItemsSource="{Binding IGService.InterstGroups}"
             MouseDoubleClick="Edit_Click"
             SelectedItem="{Binding selectedIG}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"/>
                        <TextBlock Text="{Binding Description}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
