<Page x:Class="WpfApp1.P.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.P"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Margin="5" Click="go_form">Добавить</Button>
            <Button Margin="5" Click="remove">Удалить</Button>
        </StackPanel>
        <ListView Grid.Row="1"
                  
                    ItemsSource="{Binding service.Students}"
                    MouseDoubleClick="Edit"
                    SelectedItem="{Binding SelectedStudent}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Login}"/>
                            <TextBlock Text="{Binding Email}"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}"/>
                            <TextBlock Text="{Binding Profile.Phone}"/>
                            <TextBlock Text="{Binding Profile.AvatarUrl}"/>
                            <TextBlock Text="{Binding Profile.Birthday, StringFormat={}{0:dd.MM.yyyy}}"/>
                            <TextBlock Text="{Binding Profile.Bio}"/>
                            <TextBlock Text="{Binding Role.Title}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        
        <ListView Grid.Row="1"
                  Grid.Column="1"
          
            ItemsSource="{Binding UIGService.UserInterestGroups}"
            MouseDoubleClick="Edit"
            >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding InterestGroup.Title}"/>
                            <TextBlock Text="{Binding InterestGroup.Description}"/>
                            <TextBlock Text="{Binding JoinedAt}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
